{
  "name": "call-calendar",
  "private": true,
  "workspaces": [
    "spec",
    "backend",
    "frontend"
  ],
  "type": "module",
  "scripts": {
    "generate": "npm run generate -w spec && npm run generate -w backend",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
