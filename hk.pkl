// The version must match `hk` in mise.toml.
amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"

hooks {
  ["pre-commit"] {
    // Checks only, nothing is rewritten, so leave unstaged changes in place.
    stash = "none"
    // One task, so that dependencies are installed once, not by parallel steps.
    steps {
      ["check"] { check = "mise run check:commit" }
    }
  }
  ["pre-push"] {
    steps {
      // Rewrites generated files, so it must not run alongside other steps.
      ["generated"] {
        check = "mise run check:generated"
        exclusive = true
      }
      ["check"] { check = "mise run check" }
    }
  }
}
